{
  "name": "otello",
  "version": "1.36.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data:pack": "python3 scripts/data-assets.py pack",
    "data:restore": "python3 scripts/data-assets.py restore",
    "data:verify": "python3 scripts/data-assets.py verify",
    "test:baseline": "python3 scripts/verify-baseline.py",
    "training:fetch": "python3 scripts/fetch-training-data.py",
    "training:prepare": "python3 scripts/prepare-training-data.py",
    "training:rebuild": "python3 scripts/rebuild-training-data.py",
    "training:run": "python3 scripts/train-nnue.py --hidden 256 --all-training-games --train-positions 1000000 --holdout-cache .build/training/positions.npz --cache .build/training/v1/positions.npz --output .build/training/v1/nnue256-v1.otnnue --epochs 30 --batch-size 1024 --parity-positions 1024",
    "training:compare": "python3 scripts/compare-evaluators.py --model models/nnue256-v1.otnnue",
    "training:baseline": "python3 scripts/run-v1-experiments.py",
    "training:watch": "python3 scripts/watch-matches.py",
    "test:training": "python3 -m unittest discover -s tests -p '*training_test.py'",
    "setup:egaroucid": "sh scripts/setup-egaroucid.sh",
    "test:egaroucid": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "native:serve": "node scripts/native-api.mjs",
    "dev:native": "node scripts/dev-native.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:wasm": "sh scripts/build-wasm.sh",
    "test:native": "sh scripts/test-native.sh",
    "training:baseline:v1.1": "python3 scripts/compare-versions.py",
    "training:watch:v1.1": "python3 scripts/watch-matches.py --config models/v1.1-experiments.json",
    "training:run:v1.2": "python3 scripts/train-nnue.py --architecture turn --hidden 256 --train-positions 1000000 --cache .build/training/v1/positions.npz --output .build/training/v1.2/nnue256-v1.2.otnnue --library .build/native-v1.2/libothello.dylib --epochs 30 --batch-size 1024 --parity-positions 1024",
    "training:baseline:v1.2": "python3 scripts/compare-model-versions.py",
    "training:watch:v1.2": "python3 scripts/watch-matches.py --config models/v1.2-experiments.json",
    "training:baseline:v1.3": "python3 scripts/compare-opening-policy.py",
    "training:watch:v1.3": "python3 scripts/watch-matches.py --config models/v1.3-experiments.json",
    "training:run:cnn": "python3 scripts/train-cnn.py",
    "training:baseline:v1.4": "python3 scripts/compare-cnn.py",
    "training:watch:v1.4": "python3 scripts/watch-matches.py --config models/v1.4-experiments.json",
    "training:run:resnet": "python3 scripts/train-resnet.py",
    "training:baseline:v1.5": "python3 scripts/compare-resnet.py",
    "training:watch:v1.5": "python3 scripts/watch-matches.py --config models/v1.5-experiments.json",
    "training:baseline:v1.6": "python3 scripts/compare-search-matrix.py",
    "training:watch:v1.6": "python3 scripts/watch-matches.py --config models/v1.6-experiments.json",
    "training:baseline:nnue-search": "python3 scripts/compare-nnue-search.py",
    "training:watch:nnue-search": "python3 scripts/watch-matches.py --config models/v1.6-100ms-experiments.json",
    "model:check": "python3 scripts/embed-default-model.py --check",
    "training:run:pattern": "python3 scripts/train-pattern.py",
    "training:baseline:v1.8": "python3 scripts/compare-pattern.py",
    "training:benchmark:pattern": "python3 scripts/benchmark-pattern.py",
    "test:pattern": "python3 -m unittest discover -s tests -p pattern_training_test.py",
    "test:baseline:v1.8": "python3 scripts/verify-pattern.py",
    "book:prepare": "python3 scripts/prepare-web-book.py",
    "prebuild": "node scripts/prepare-web-release.mjs",
    "predev": "python3 scripts/prepare-web-book.py",
    "test:pattern:outcome": "python3 scripts/finalize-pattern-outcome.py --verify",
    "training:run:pattern:outcome": "python3 scripts/train-pattern-outcome.py",
    "training:baseline:pattern:outcome": "python3 scripts/compare-nnue-candidate.py --model models/pattern32-outcome-v1.25.otpat --label v1.25-pattern-outcome --baseline-manifest models/v1.9-default.json --baseline-library .build/native-v1.9-reference/libothello.dylib --games 20 --milliseconds 100 --seed 20261029 --output .build/training/pattern-outcome-v1.25/match.json"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
